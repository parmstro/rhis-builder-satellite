---
# RHIS Disconnected Export Bundle Manifest
# Generated by export_disconnected.yml — do not edit manually.
# Used by copy_rhis_to_transfer_media.sh and build_sat_disconnected_import.sh
# to validate bundle integrity after transfer.

bundle:
  generated: "{{ _manifest_timestamp }}"
  source_satellite: "{{ _satellite_fqdn }}"
  satellite_version: "{{ _satellite_version }}"
  bundle_path: "{{ _bundle_path }}"
  pulp_export_path: "{{ _pulp_path }}"

highside_manifests:
{% if _manifest_list | length > 0 %}
{% for m in _manifest_list %}
  - "{{ m }}"
{% endfor %}
{% else %}
  []  # WARNING: No highside manifests found at export time
{% endif %}

ansible_roles:
  # Role files were copied as-is from /etc/ansible/roles/ on the source satellite.
  # The operator is responsible for ensuring that directory contained what they tested.
  # Per-file SHA256 checksums below provide complete integrity verification.
  # Git SHAs are not recorded — they do not reliably reflect uncommitted local changes.
  source_path: "/etc/ansible/roles/"
  integrity: "Verified via bundle_checksums below (ansible_roles/ subtree)"

bundle_checksums:
{% for result in _checksum_results %}
{% if result.stat is defined and result.stat.checksum is defined %}
  - path: "{{ result.stat.path | replace(_bundle_path + '/', '') }}"
    sha256: "{{ result.stat.checksum }}"
    size: "{{ result.stat.size }}"
{% endif %}
{% endfor %}
