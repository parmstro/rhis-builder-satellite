---
# content_imports.yml
# Auto-generated by export_disconnected.yml on {{ generation_datetime }}
# Drop this file into host_vars/<discosatellite_fqdn>/ on the highside inventory
# and run the import playbook. No manual configuration required.
#
# Source satellite: {{ ansible_fqdn }}

content_imports:
{% for item in content_imports %}
  - name: "{{ item.name }}"
    type: "{{ item.type }}"
    import_path: "{{ item.import_path }}"
    metadata_file: "{{ item.metadata_file }}"
{% endfor %}
